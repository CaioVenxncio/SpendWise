  "fixed_sql": [
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id\" TEXT NOT NULL UNIQUE, \"amount_cents\" INTEGER NOT NULL CHECK(\"amount_cents\" BETWEEN -9007199254740991 AND 9007199254740991), \"description\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"occurred_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "migration_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"migration_snapshots\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"source_key\" TEXT NOT NULL, \"fingerprint\" TEXT NOT NULL UNIQUE, \"raw_text\" TEXT NULL, \"legacy_backup_text\" TEXT NULL, \"captured_at\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "migration_runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"migration_runs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"snapshot_id\" INTEGER NOT NULL UNIQUE REFERENCES migration_snapshots (id), \"algorithm_version\" INTEGER NOT NULL, \"source_records\" INTEGER NOT NULL, \"imported_records\" INTEGER NOT NULL, \"already_present\" INTEGER NOT NULL, \"duplicates_collapsed\" INTEGER NOT NULL, \"had_legacy_records\" INTEGER NOT NULL CHECK (\"had_legacy_records\" IN (0, 1)), \"total_cents\" TEXT NOT NULL, \"approved_changed_source\" INTEGER NOT NULL CHECK (\"approved_changed_source\" IN (0, 1)), \"completed_at\" TEXT NOT NULL);"
        }
      ]
